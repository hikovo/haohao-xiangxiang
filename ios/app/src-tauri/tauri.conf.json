{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "好好想想",
  "mainBinaryName": "sanhao-tu",
  "version": "2.2.4",
  "identifier": "com.hikovo.sanhaotu",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": false,
    "windows": [
      {
        "label": "main",
        "title": "好好想想",
        "width": 390,
        "height": 844,
        "visible": true,
        "disableInputAccessoryView": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "一只喜欢跳舞、发呆和窝在小家里陪伴你的三好兔～ᕱ⑅ᕱ ♡",
    "longDescription": "一只喜欢跳舞、发呆和窝在小家里陪伴你的三好兔～ᕱ⑅ᕱ ♡",
    "macOS": {
      "signingIdentity": "-",
      "dmg": {
        "windowSize": {
          "width": 380,
          "height": 180
        },
        "windowPosition": {
          "x": 240,
          "y": 180
        },
        "appPosition": {
          "x": 275,
          "y": 85
        },
        "applicationFolderPosition": {
          "x": 105,
          "y": 85
        }
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
